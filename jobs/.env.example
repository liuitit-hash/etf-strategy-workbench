# 复制为 .env（本地调试）或配置为 GitHub Actions Secrets。
# 注意：SERVICE_ROLE_KEY 权限极高，只放在 GitHub Secrets / 本地 .env，绝不进前端、不提交仓库。

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# LLM（DeepSeek，OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat          # 需要更强推理可换 deepseek-reasoner
LLM_TEMPERATURE=0.3

# 市场与时区（影响交易日判断/新闻抓取口径）
MARKET=a-share                    # a-share / hk
TZ=Asia/Shanghai
